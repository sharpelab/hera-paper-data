diff --git a/tests/hera/test_hera_watch_cli.py b/tests/hera/test_hera_watch_cli.py
new file mode 100644
index 0000000..cc464e6
--- /dev/null
+++ b/tests/hera/test_hera_watch_cli.py
@@ -0,0 +1,90 @@
+"""CLI-level tests for tools.hera_watch — the argument/timeout plumbing.
+
+The engine (hera.watch) is covered by test_watch.py; here we pin the CLI's
+TTY-vs-background timeout resolution (T-1) and the --next / arm-before-run
+wiring (T-2), capturing the kwargs handed to watch() rather than running it.
+"""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from tools import hera_watch
+
+
+def _write_run(d: Path):
+    d.mkdir(parents=True)
+    (d / "metadata.json").write_text(json.dumps({
+        "version": 2,
+        "comments": ["test"],
+        "columns": ["mag", "sr1_X", "sr1_P"],
+        "measurement_config": {"sr1": "a-b"},
+        "type": "1D",
+        "fast_params": ["mag"],
+        "fast_setpoints": [[0.0, 1.0]],
+        "start_time": 1000.0,
+    }))
+    (d / "data.tsv").write_text("0.0\t1e-6\t0.0\n")
+
+
+@pytest.fixture
+def capture_watch(monkeypatch):
+    """Replace watch() with a recorder; returns the captured kwargs dict."""
+    captured = {}
+
+    def fake_watch(model, **kwargs):
+        captured["model"] = model
+        captured.update(kwargs)
+        return 0
+
+    monkeypatch.setattr(hera_watch, "watch", fake_watch)
+    return captured
+
+
+def test_timeout_default_interactive_tty(tmp_path, monkeypatch, capture_watch):
+    _write_run(tmp_path / "3")
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: True)
+    assert hera_watch.main([str(tmp_path / "3")]) == 0
+    assert capture_watch["timeout"] == 570.0  # foreground stays capped
+
+
+def test_timeout_default_backgrounded(tmp_path, monkeypatch, capture_watch):
+    _write_run(tmp_path / "3")
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: False)
+    assert hera_watch.main([str(tmp_path / "3")]) == 0
+    assert capture_watch["timeout"] is None  # backgrounded -> follow forever
+
+
+def test_follow_flag_overrides_tty(tmp_path, monkeypatch, capture_watch):
+    _write_run(tmp_path / "3")
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: True)
+    assert hera_watch.main([str(tmp_path / "3"), "--follow"]) == 0
+    assert capture_watch["timeout"] is None
+
+
+def test_explicit_timeout_wins(tmp_path, monkeypatch, capture_watch):
+    _write_run(tmp_path / "3")
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: False)
+    assert hera_watch.main([str(tmp_path / "3"), "--timeout", "120"]) == 0
+    assert capture_watch["timeout"] == 120.0
+
+
+def test_next_resolves_to_next_id(tmp_path, monkeypatch, capture_watch):
+    data = tmp_path / "data"
+    _write_run(data / "5")          # highest existing id is 5
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: False)
+    # The next run is data/6; create it so wait_for_run resolves immediately.
+    _write_run(data / "6")
+    assert hera_watch.main(["--next", str(data)]) == 0
+    assert capture_watch["model"].path.name == "6"
+
+
+def test_missing_dir_times_out(tmp_path, monkeypatch, capsys):
+    monkeypatch.setattr(hera_watch.sys.stdout, "isatty", lambda: False)
+    # Tiny wait-start with a real (instant) sleep: the deadline trips on the
+    # first poll since the target never appears.
+    rc = hera_watch.main([str(tmp_path / "nope"), "--wait-start", "0.001",
+                          "--poll", "0"])
+    assert rc == 2
+    assert "did not appear" in capsys.readouterr().err
