+def run_dir_ready(path: str | Path) -> bool:
+    """True once ``path`` is a run dir sweep has populated enough to model:
+    the directory exists and holds a ``metadata.json``. Sweep creates the
+    dir and writes metadata before the first row lands, so this is the
+    earliest point ``build_model`` can succeed."""
+    path = Path(path).expanduser()
+    return path.is_dir() and (path / "metadata.json").exists()
+
+
+def resolve_next_run(data_dir: str | Path) -> Path:
+    """Predict the next integer file_id dir sweep will allocate under
+    ``data_dir``. Sweep names run dirs by ascending integer (``data/117``,
+    ``118``, …); the next run is ``max(existing) + 1`` (or ``0`` if none).
+    Lets a watch be armed for a cell *before* it runs, without coupling to
+    sweep's id allocator — the dir is then waited for via ``wait_for_run``."""
+    data_dir = Path(data_dir).expanduser()
+    highest = -1
+    if data_dir.is_dir():
+        for child in data_dir.iterdir():
+            if child.is_dir() and child.name.isdigit():
+                highest = max(highest, int(child.name))
+    return data_dir / str(highest + 1)
+
+
+def wait_for_run(
+    path: str | Path,
+    *,
+    timeout: float = 1800.0,
+    poll: float = 5.0,
+    now_fn=time.time,
+    sleep_fn=time.sleep,
+    emit=None,
+) -> bool:
+    """Block until ``path`` becomes a modellable run dir (see
+    ``run_dir_ready``), or ``timeout`` seconds elapse. Returns True if the
+    dir appeared, False on timeout. ``timeout <= 0`` waits indefinitely.
+
+    This is the "arm before the operator starts the cell" gate: poll for the
+    data dir to appear instead of requiring it to exist up front."""
+    path = Path(path).expanduser()
+    if run_dir_ready(path):
+        return True
+    if emit is not None:
+        emit(f"# waiting for run dir {path} to appear …")
+    deadline = now_fn() + timeout if timeout > 0 else None
+    while True:
+        sleep_fn(poll)
+        if run_dir_ready(path):
+            return True
+        if deadline is not None and now_fn() >= deadline:
+            return False
+
+
