-    def items(self) -> list[tuple[str, Parameter, Any]]:
-        return list(self._entries)
-
-    def __iter__(self):
-        return iter(self._entries)
-
-    def __len__(self) -> int:
-        return len(self._entries)
-
-    def __contains__(self, param: Parameter) -> bool:
