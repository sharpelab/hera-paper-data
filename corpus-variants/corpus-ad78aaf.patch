-"""
-from typing import Any, Callable
-
-from qcodes.parameters import Parameter
-
-StageItem = tuple[Parameter, Any] | tuple[str, Callable[[], None]]
-
-
-class StateRecord:
-    """An ordered, read-only snapshot of ``(name, param, value)`` triples.
