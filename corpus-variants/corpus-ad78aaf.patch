-            out[tag] = np.nan
-            continue
-        f, p = column_spectrum(bb, rr, bb.min(), bb.max(), cutoff)
-        tol = max(f_floor_half, 0.06 * F0)
-        p0 = power_at(f, p, F0, tol)
-        pr = power_at(f, p, F_ref, max(f_floor_half, 0.06 * F_ref))
-        out[tag] = p0 / pr if pr > 0 else np.nan
-    return out
