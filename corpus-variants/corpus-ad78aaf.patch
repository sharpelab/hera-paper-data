-    mid = 0.5 * (invB.min() + invB.max())
-    lowB = B <= (1.0 / mid)                     # small B  = large 1/B
-    hiB = B >= (1.0 / mid)                      # large B  = small 1/B
-    out = {}
-    for tag, mask in (("lowB", lowB), ("hiB", hiB)):
