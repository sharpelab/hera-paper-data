-    for ax, r in zip(np.atleast_1d(axes), rows):
-        ax.plot(r["freq"], r["psd"], lw=0.9)
-        FLn = r["F_L_nom"]
-        ax.axvline(s_fit * FLn, color="k", ls="--", lw=0.8)
