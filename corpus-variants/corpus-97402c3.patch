-def _radial_orbits(kg, Eb, EF):
-    """Every Onsager crossing at EF: list of (F, kF, band, index)."""
-    out = []
-    for b in range(Eb.shape[0]):
-        cross = np.where((Eb[b, :-1] - EF) * (Eb[b, 1:] - EF) < 0)[0]
-        for c in cross:
-            out.append((F_from_area(np.pi * kg[c] ** 2), kg[c], b, c))
-    return out
