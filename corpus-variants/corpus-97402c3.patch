-                workdir = dest / "workdir"
-                self._build_workdir(fm, workdir)
-
-
-
-                tasks.append({
-                    "dest": dest,
-                    "workdir": workdir,
-                    "checkpoint": self.checkpoint,
-                    "fm": fm,
-                    "prompt": prompt,
-                    "recipes_dir": recipes_dir,
-                    "model": model,
-                    "label": ctx_["label"],
-                    "sample": n,
-                    "timeout": timeout,
-                    "env": env,
