-# ---------------- pipeline primitives (faithful reimplementation) ----------------
-
-def detrend_poly_B(B, y, degree=5):
-    coeff = np.polyfit(B, y, degree)
-    out = y - np.polyval(coeff, B)
-    return out - out.mean()
-
-
-def interp_to_invB(B, y, nx=1000):
