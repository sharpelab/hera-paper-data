-        f'  |> filter(fn: (r) => r["_measurement"] == "{measurement}")'
-        f'  |> filter(fn: (r) => r["metric"] == "{metric}")'
-        f'  |> filter(fn: (r) => r["_field"] == "value")'
-    )
-    if unit is not None:
-        query += f'  |> filter(fn: (r) => r["unit"] == "{unit}")'
