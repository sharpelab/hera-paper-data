-        if abs(scale_factor - 1.0) <= scaling:
-            scaled_sum = base_sum * scale_factor
-            error = abs(scaled_sum - 1.0)
-            solutions[coeffs] = (scaled_sum, scale_factor, error)
-    
-    return solutions
