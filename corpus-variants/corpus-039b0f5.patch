-
-def detrend_butter_invB(invB, y, cutoff, order=2):
-    d = np.median(np.diff(invB))
-    fs = 1.0 / abs(d)
-    nyq = 0.5 * fs
-    Wn = np.clip(cutoff / nyq, 1e-6, 0.999)
-    sos = butter(order, Wn, btype="highpass", output="sos")
-    out = sosfiltfilt(sos, y)
-    return out - out.mean()
