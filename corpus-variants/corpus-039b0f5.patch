-# ----------------------------------------------------------------------------
-# Fan registry — the sweeps to run, with their regime and analysis field window.
-# ----------------------------------------------------------------------------
-FANS = [
-    dict(id=1840, contact=2, D=1.0, blo=0.7, bhi=5.0,
