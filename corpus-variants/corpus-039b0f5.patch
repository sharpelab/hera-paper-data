-        )
-        (run_root / "comparison.md").write_text("\n".join(out) + "\n", encoding="utf-8")
-        (run_root / "comparison.json").write_text(
-            json.dumps(
-                {
-                    "checkpoint": str(checkpoint),
-                    "frontier": frontier_name,
-                    "samples_per_ref": samples_per_ref,
