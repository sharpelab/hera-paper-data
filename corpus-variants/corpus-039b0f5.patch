-    order = np.argsort(invB)
-    invB_s, y_s = invB[order], y[order]
-    grid = np.linspace(invB_s[0], invB_s[-1], nx)
-    cs = scipy.interpolate.CubicSpline(invB_s, y_s)
-    return grid, cs(grid)
