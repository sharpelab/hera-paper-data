-    Returns
-    -------
-    out : array
-        Detrended signal.
-    bg : array
-        Polynomial background.
-    """
-    y = np.asarray(y, float)
-    idx = np.isfinite(y) & np.isfinite(B)
-    coeff = np.polyfit(B[idx], y[idx], degree)
-    bg = np.polyval(coeff, B)
-    out = y - bg
-    out -= np.nanmean(out)
-    return out, bg
