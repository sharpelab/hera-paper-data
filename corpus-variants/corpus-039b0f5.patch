-    def density(EF):
-        tot = 0.0
-        for b in range(nb):
-            cross = np.where((Eb[b, :-1] - EF) * (Eb[b, 1:] - EF) < 0)[0]
-            for c in cross:
-                sgn = 1.0 if Eb[b, c + 1] > Eb[b, c] else -1.0
-                tot += sgn * kg[c] ** 2 / np.pi
