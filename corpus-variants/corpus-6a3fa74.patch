-        f_nu = n_sdh / abs(n) if n != 0 else np.nan
-        g, grel = snap_g(f_nu)
-        out.append(dict(f=f, power=p, n_sdh=n_sdh, f_nu=f_nu,
-                        ratio_FL=f / FLn, g=g, g_rel=grel))
-    return out
