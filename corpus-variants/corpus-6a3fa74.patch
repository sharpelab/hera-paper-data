-
-
-# ---------------- per-case evaluation ----------------
-
-def evaluate_case(name, make_png=True):
-    d = DATA_DIR / name
-    z = np.load(d / "fan.npz")
-    truth = json.load(open(d / "truth.json"))
-    B, ncol = z["B"], z["n"]
