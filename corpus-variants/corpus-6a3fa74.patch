-def snap_g(f_nu):
-    """Snap n/n_SdH = 1/f_nu to the nearest allowed isospin degeneracy {1,2,4}."""
-    if f_nu <= 0 or not np.isfinite(f_nu):
-        return None, np.inf
-    g_est = 1.0 / f_nu
-    cands = np.array([1, 2, 4])
-    k = int(np.argmin(np.abs(cands - g_est)))
-    g = int(cands[k])
-    rel = abs(g_est - g) / g
-    return g, rel
