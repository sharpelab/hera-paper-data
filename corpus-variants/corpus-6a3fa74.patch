-def lk_effective_mass(ids=LK_IDS, contact=2):
-    """Extract the CQM SdH amplitude vs T and fit the LK thermal damping
-    R_T(T) = X/sinh(X), X = 2*pi^2*kB*T*m* / (hbar*e*B_eff), for m*."""
