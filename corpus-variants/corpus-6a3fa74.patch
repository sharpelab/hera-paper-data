+{
+ "cells": [
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": "# Toploader Measurement \u2014 b1c2 variant\n\n*Hand-customized for the b1c2 dual-device chip (Isaac). Auto-generation from device cards is an action item; for now, edits are by hand. See `~/measurement_env/templates/toploader_measure.ipynb` for the generic template.*\n\n## Config\nEdit the cell below for each new run. Standard toploader settings follow."
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "# === CONFIG ===\n",
+    "\n",
+    "# -- Per-run (edit these) --\n",
+    "# Alert recipients \u2014 registry names or raw IDs/addresses, single or list\n",
+    "ALERT_DISCORD = []  # e.g. [\"asharpe\"] or [\"123456789012345678\"]\n",
+    "ALERT_SLACK   = []  # e.g. [\"asharpe\"] or [\"U0123456789\"]\n",
+    "ALERT_EMAIL   = []  # e.g. [\"asharpe\"] or [\"user@example.edu\"]\n",
+    "\n",
+    "# Gate sources: name -> {addr, limit, step}\n",
+    "GATES = {\n",
+    "    # b1c2: dual-device chip, top + bottom gates per device. Active gates for\n",
+    "    # this template are the *top device* gates. Validators \u00b14 V \u2014 conservative\n",
+    "    # starting cap; widen only after gate-current/top/back checks bless ranges.\n",
+    "    \"k_tg\": {\"addr\": \"GPIB4::9::INSTR\",  \"limit\": (-4.0, 4.0), \"step\": 0.005},\n",
+    "    \"k_bg\": {\"addr\": \"GPIB4::10::INSTR\", \"limit\": (-4.0, 4.0), \"step\": 0.005},\n",
+    "    # No k_si \u2014 b1c2 has a metal back gate (no SiO2 layer); silicon-backgate-survey\n",
+    "    # does not apply to this device.\n",
+    "}\n",
+    "\n",
+    "# -- Toploader standard (don't edit unless hardware changes) --\n",
+    "MAGNET_ADDR = \"TCPIP0::192.168.0.101::7180::SOCKET\"\n",
+    "\n",
+    "SR830_ADDRS = {\n",
+    "    1: \"GPIB0::8::INSTR\",\n",
+    "    2: \"GPIB0::9::INSTR\",\n",
+    "    3: \"GPIB0::4::INSTR\",\n",
+    "    4: \"GPIB0::1::INSTR\",\n",
+    "    5: \"GPIB0::5::INSTR\",\n",
+    "    6: \"GPIB0::6::INSTR\",\n",
+    "    7: \"GPIB0::7::INSTR\",\n",
+    "    # 8: \"TCPIP::192.168.0.106::inst0::INSTR\",  # SR860 \u2014 not wired on b1c2\n",
+    "    # 9: \"GPIB5::27::INSTR\",                    # not wired on b1c2\n",
+    "}\n",
+    "\n",
+    "# Active wiring: bottom gate (current preamp on sr830_1)\n",
+    "SR830_GAINS = {\n",
+    "    1: -1E6, 2: 100, 3: 100, 4: 100,\n",
+    "    5: 100, 6: 100, 7: 100,\n",
+    "}\n",
+    "# Top gate wiring (uncomment + comment-out the above when switching):\n",
+    "# SR830_GAINS = {\n",
+    "#     1: 100, 2: 100, 3: 100, 4: -1E6,\n",
+    "#     5: 100, 6: 100, 7: 100,\n",
+    "# }\n",
+    "\n",
+    "KEITHLEY_DEFAULTS = {\n",
+    "    \"mode\": \"VOLT\",\n",
+    "    \"rangev\": 21,\n",
+    "    \"rangei\": 1e-6,\n",
+    "    \"compliancev\": 20,\n",
+    "    \"compliancei\": 1e-6,\n",
+    "}"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "---\n",
+    "## Setup\n",
+    "Run all cells below to initialize instruments."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "import numpy as np\n",
+    "import qcodes\n",
+    "from qcodes import validators\n",
+    "import time\n",
+    "import sweep\n",
+    "from sweep import raster\n",
+    "import pyvisa as visa\n",
+    "from IPython.display import clear_output\n",
+    "\n",
+    "from qcodes.instrument_drivers.stanford_research import SR830, SR860\n",
+    "from qcodes.instrument_drivers.Keithley import Keithley2400\n",
+    "from qcodes.instrument_drivers.american_magnetics import AMIModel430\n",
+    "\n",
+    "from sharpelab_nb import Status\n",
+    "from sharpelab_nb.constants import TOPLOADER\n",
+    "from sharpelab_nb.thermometry import temperature_from_logfile\n",
+    "from sharpelab_nb.drivers import SRS_DC205, Yokogawa7651"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": "# Alerts\nfrom measurebot import alerts\nalerts.show_config()\nalerts.set_defaults(discord_user=ALERT_DISCORD, slack_user=ALERT_SLACK, email_user=ALERT_EMAIL)\nalerts.slack(f\"\\U0001f40d connected \\U0001f40d\")",
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "# VISA\n",
+    "rm = visa.ResourceManager()\n",
+    "print(rm.list_resources())"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "sweep.set_basedir('./data')"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "# Magnet\n",
+    "mag = AMIModel430(\"magnet\", address=MAGNET_ADDR)\n",
+    "print(f\"Field: {mag.field()} T\")"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "# Lock-in amplifiers\n",
+    "sr830s_by_idx = {}\n",
+    "for idx, addr in SR830_ADDRS.items():\n",
+    "    name = f\"sr830_{idx}\"\n",
+    "    if \"TCPIP\" in addr:\n",
+    "        sr830s_by_idx[idx] = SR860(name, addr)\n",
+    "    else:\n",
+    "        sr830s_by_idx[idx] = SR830(name, addr)\n",
+    "\n",
+    "sr830s = [(sr830s_by_idx[i], SR830_GAINS[i]) for i in sorted(sr830s_by_idx)]\n",
+    "\n",
+    "for i, (srs, gain) in enumerate(sr830s):\n",
+    "    idx = sorted(sr830s_by_idx)[i]\n",
+    "    print(f\"  {idx}: X={srs.X():.4e}  gain={gain}\")\n",
+    "\n",
+    "# Expose as individual variables for convenience\n",
+    "for idx, inst in sr830s_by_idx.items():\n",
+    "    globals()[f\"sr830_{idx}\"] = inst"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": [
+    "# Gate sources\n",
+    "gate_instruments = {}\n",
+    "for name, cfg in GATES.items():\n",
+    "    k = Keithley2400(name, cfg[\"addr\"])\n",
+    "    k.mode.set(KEITHLEY_DEFAULTS[\"mode\"])\n",
+    "    k.rangev.set(KEITHLEY_DEFAULTS[\"rangev\"])\n",
+    "    k.rangei.set(KEITHLEY_DEFAULTS[\"rangei\"])\n",
+    "    k.compliancev.set(KEITHLEY_DEFAULTS[\"compliancev\"])\n",
+    "    k.compliancei.set(KEITHLEY_DEFAULTS[\"compliancei\"])\n",
+    "    k.output.set(1)\n",
+    "    k.volt.step = cfg[\"step\"]\n",
+    "    lo, hi = cfg[\"limit\"]\n",
+    "    k.volt.remove_validator()\n",
+    "    k.volt.add_validator(validators.Numbers(lo, hi))\n",
+    "    gate_instruments[name] = k\n",
+    "    globals()[name] = k\n",
+    "    print(f\"  {name}: {cfg['addr']}  limits=({lo}, {hi})\")"
+   ],
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": "# Temperature readout\ntemperature = temperature_from_logfile(\"T\", TOPLOADER.temp_logfiles[\"T_probe\"])\nfridge_temperature = temperature_from_logfile(\"T_fridge\", TOPLOADER.temp_logfiles[\"T_fridge\"])\nmag_temperature = temperature_from_logfile(\"T_mag\", TOPLOADER.temp_logfiles[\"T_magnet\"])\n\nprint(f\"Probe:  {temperature()} K\")\nprint(f\"Fridge: {fridge_temperature()} K\")\nprint(f\"Magnet: {mag_temperature()} K\")",
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "source": "# UPS safe shutdown\nfrom sharpelab_nb.ups import start_ups_monitor\n\ndef safe_shutdown():\n    s = sweep.AsyncStation()\n    s.ramp(k_bg.volt, 0)\n    s.ramp(k_tg.volt, 0)\n    # No k_si \u2014 b1c2 has no Si BG.\n    s.ramp(mag.field, 0)\n\nups_monitor = start_ups_monitor(safe_shutdown)",
+   "metadata": {},
+   "execution_count": null,
+   "outputs": []
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": "---\n## Measurements\nDefine your measurement config before each sweep. The `mc` dict maps lock-ins\nto contact pairs; `contact_pairs` assigns roles (longitudinal, hall, current)\nto groups of channels. Update both as you rewire."
+  },
+  {
+   "cell_type": "code",
+   "metadata": {},
+   "source": "from sharpelab_nb import build_measurement_config\n\n# Channel -> contact wiring (update when you rewire)\nmc = {\n    \"sr830_1\": \"29-28\",\n    \"sr830_2\": \"28-25\",\n    \"sr830_3\": \"25-24\",\n    \"sr830_4\": \"I_{30-17}\",\n    \"sr830_5\": \"13-14\",\n    \"sr830_6\": \"10-11\",\n    \"sr830_7\": \"11-13\",\n    \"sr830_8\": \"14-15\",\n    \"sr830_9\": \"24-22\",\n}\n\n# Role -> which lock-in channels measure it\ncontact_pairs = {\n    \"long\": {\"channels\": [1, 2, 3]},\n    \"hall\": {\"channels\": [5, 6, 7]},\n    \"curr\": {\"channels\": [4]},\n}\n\nmeasurement_config = build_measurement_config(mc, contact_pairs)",
+   "outputs": [],
+   "execution_count": null
+  },
+  {
+   "cell_type": "code",
+   "source": "# Status \u2014 customize with the parameters you care about\nstatus = Status(\n    field=mag.field,\n    T=temperature,\n    **{name: inst.volt for name, inst in gate_instruments.items()},\n)\nstatus()",
+   "metadata": {},
+   "execution_count": null,
+   "outputs": []
+  },
+  {
+   "cell_type": "code",
+   "source": "",
+   "metadata": {},
+   "execution_count": null,
+   "outputs": []
+  }
+ ],
