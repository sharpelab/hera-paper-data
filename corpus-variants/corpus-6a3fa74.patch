-    freshest = None
-    freshest_mtime = None
-    for path in log_files:
-        try:
-            mtime = os.path.getmtime(path)
-        except OSError:
-            continue
-        if freshest_mtime is None or mtime > freshest_mtime:
-            freshest, freshest_mtime = path, mtime
