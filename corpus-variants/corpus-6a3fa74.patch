-          f"{f['B'].size} field pts x {f['n'].size} gate cols; "
-          f"n {f['n'].min():.2f}..{f['n'].max():.2f}, D≈{np.median(f['D']):.2f}")
-    s = load_field_sweep(1639, contact=2)
