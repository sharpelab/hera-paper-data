-def _stdin_reader(cmd_q: queue.Queue[str]) -> None:
-    """Feed stdin lines into the queue; ends quietly on EOF."""
-    for line in sys.stdin:
-        line = line.strip()
-        if line:
-            cmd_q.put(line)
