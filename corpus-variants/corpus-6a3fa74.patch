+   "source": [
+    "# PATTERN — Landau-fan re-plot (set the file id).\n",
+    "dat = sl.pload(file_path, <FILE_ID>)\n",
+    "\n",
+    "n, D = calc_nD(dat['xs'][0], dat['xs'][1], c_tg, c_bg)\n",
+    "n_12cm = n * 1e-16  # 10^12 cm^-2\n",
+    "ys = dat['ys'][0]   # B (T)\n",
+    "\n",
